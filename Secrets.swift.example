import Foundation

/// Copy this file to Secrets.swift and fill in your own keys.
/// Secrets.swift is git-ignored so the real values never reach the repository.
enum Secrets {
    
    /// National Rail Live Departure Board API key
    /// Get yours at: https://raildata.org.uk/
    static let railDataKey = "YOUR_RAIL_DATA_API_KEY"
    
    /// Realtime Trains Next Generation API refresh token (used by RTTService)
    /// Get yours at: https://api-portal.rtt.io
    static let rttRefreshToken = "YOUR_RTT_REFRESH_TOKEN"

    /// Rail Data Marketplace "Knowledgebase Incidents" key, for planned engineering works.
    /// Subscribe to that product at https://raildata.org.uk/ (it is separate from the departure board)
    static let knowledgebaseKey = "YOUR_KNOWLEDGEBASE_INCIDENTS_KEY"
}
